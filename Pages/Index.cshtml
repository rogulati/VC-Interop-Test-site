@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-shield-check me-2"></i>Microsoft Entra Verified ID</h4>
</div>

<!-- Summary Card -->
<div class="card section-card">
    <div class="card-header">
        <i class="bi bi-info-circle me-2"></i>Quick Actions
    </div>
    <div class="card-body">
        <p class="text-muted mb-4">Issue and verify decentralized identity credentials using Microsoft Entra Verified ID.</p>
        
        <div class="row g-4 justify-content-center">
            <div class="col-md-5">
                <a href="/Issuer" class="home-action-card card h-100" style="text-decoration:none;">
                    <div class="card-body">
                        <i class="bi bi-file-earmark-plus display-4 text-primary"></i>
                        <h5 class="mt-3 mb-2">Issue Credential</h5>
                        <p class="text-muted small mb-0">Issue a Verified ID credential to a user's digital wallet</p>
                    </div>
                </a>
            </div>
            <div class="col-md-5">
                <a href="/Verifier" class="home-action-card card h-100" style="text-decoration:none;">
                    <div class="card-body">
                        <i class="bi bi-patch-check display-4 text-success"></i>
                        <h5 class="mt-3 mb-2">Verify Credential</h5>
                        <p class="text-muted small mb-0">Verify a presented credential with optional FaceCheck</p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>