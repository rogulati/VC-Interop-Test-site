<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"] - Verified ID Test Site</title>
    <meta name="description" content="Microsoft Entra Verified ID">
    <meta name="author" content="Microsoft">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/styles.css?v=2" />
    <link rel="icon" href="/favicon.png">       
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-shield-check me-2"></i>
                Verified ID Test Site
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            <i class="bi bi-house me-1"></i> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Issuer">
                            <i class="bi bi-file-earmark-plus me-1"></i> Issue
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Verifier">
                            <i class="bi bi-patch-check me-1"></i> Verify
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container py-4">
            @RenderBody()
    </main>

    <footer>
        <div class="container text-center">
            <p class="mb-0">&copy; 2026 - Entra Verified ID Issuance and Presentation Test site</p>
        </div>
    </footer>

    <script src="/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
 