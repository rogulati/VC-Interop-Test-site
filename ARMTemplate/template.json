{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "webAppName": {
      "type": "string",
      "metadata": {
        "description": "Unique name for your Azure App Service (will be part of URL: <name>.azurewebsites.net)"
      },
      "minLength": 2
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources."
      }
    },
    "tenantId": {
      "type": "string",
      "metadata": {
        "description": "Your Microsoft Entra ID tenant ID (GUID)"
      }
    },
    "clientId": {
      "type": "string",
      "metadata": {
        "description": "Application (client) ID from your app registration"
      }
    },
    "clientSecret": {
      "type": "securestring",
      "metadata": {
        "description": "Client secret from your app registration"
      }
    },
    "issuerAuthority": {
      "type": "string",
      "metadata": {
        "description": "Your Verified ID Issuer DID (e.g., did:web:yourdomain.com)"
      }
    },
    "verifierAuthority": {
      "type": "string",
      "metadata": {
        "description": "Your Verified ID Verifier DID (e.g., did:web:yourdomain.com)"
      }
    },
    "credentialManifest": {
      "type": "string",
      "metadata": {
        "description": "Manifest URL for the WoodgroveTraining issuance flow"
      }
    },
    "manifestVerifiedIdentity": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Manifest URL for the VerifiedIdentity issuance flow (leave blank to use the value baked into issuance_request_config_verifiedidentity.json)"
      }
    },
    "cpAuthorityId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Your Verified ID CP Authority ID (GUID) - used for token details API"
      }
    },
    "verificationProvider": {
      "type": "string",
      "defaultValue": "VIDTeamIDV",
      "metadata": {
        "description": "Value for the VerifiedIdentity verificationProvider claim (not entered in the issuance form)"
      }
    },
    "manifestEmployee": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Manifest URL for the Directory based - Employee issuance flow"
      }
    },
    "manifestIdTokenHint": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Manifest URL for the Id token hint attestation issuance flow"
      }
    },
    "manifestIdToken": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Manifest URL for the Id token attestation issuance flow"
      }
    },
    "manifestPresentation": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Manifest URL for the Presentation attestation issuance flow"
      }
    },
    "manifestSelfIssued": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Manifest URL for the Self issued attestation issuance flow"
      }
    },
    "manifestMultiple": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Manifest URL for the Multiple attestations issuance flow"
      }
    },
    "typeEmployee": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Credential type for the Directory based - Employee issuance flow"
      }
    },
    "typeIdTokenHint": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Credential type for the Id token hint attestation issuance flow"
      }
    },
    "typeIdToken": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Credential type for the Id token attestation issuance flow"
      }
    },
    "typePresentation": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Credential type for the Presentation attestation issuance flow"
      }
    },
    "typeSelfIssued": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Credential type for the Self issued attestation issuance flow"
      }
    },
    "typeMultiple": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Credential type for the Multiple attestations issuance flow"
      }
    },
    "idTokenHintGivenName": {
      "type": "string",
      "defaultValue": "Megan",
      "metadata": {
        "description": "Sample 'given_name' claim value for the Id token hint attestation flow"
      }
    },
    "idTokenHintFamilyName": {
      "type": "string",
      "defaultValue": "Bowen",
      "metadata": {
        "description": "Sample 'family_name' claim value for the Id token hint attestation flow"
      }
    },
    "multipleGivenName": {
      "type": "string",
      "defaultValue": "Megan",
      "metadata": {
        "description": "Sample 'given_name' claim value for the idTokenHint portion of the Multiple attestations flow"
      }
    },
    "multipleFamilyName": {
      "type": "string",
      "defaultValue": "Bowen",
      "metadata": {
        "description": "Sample 'family_name' claim value for the idTokenHint portion of the Multiple attestations flow"
      }
    }
  },
  "variables": {
    "appServicePlanName": "[concat('asp-', parameters('webAppName'))]",
    "webSiteName": "[parameters('webAppName')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-09-01",
      "name": "[variables('appServicePlanName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "F1",
        "tier": "Free",
        "size": "F1",
        "family": "F",
        "capacity": 1
      },
      "properties": {
        "reserved": false
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-09-01",
      "name": "[variables('webSiteName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "netFrameworkVersion": "v8.0",
          "metadata": [
            {
              "name": "CURRENT_STACK",
              "value": "dotnet"
            }
          ],
          "appSettings": [
            {
              "name": "AppSettings__Endpoint",
              "value": "https://verifiedid.did.msidentity.com/v1.0/"
            },
            {
              "name": "AppSettings__VCServiceScope",
              "value": "3db474b9-6a0c-4840-96ac-1fceb342124f/.default"
            },
            {
              "name": "AppSettings__Instance",
              "value": "https://login.microsoftonline.com/{0}"
            },
            {
              "name": "AppSettings__TenantId",
              "value": "[parameters('tenantId')]"
            },
            {
              "name": "AppSettings__ClientId",
              "value": "[parameters('clientId')]"
            },
            {
              "name": "AppSettings__ClientSecret",
              "value": "[parameters('clientSecret')]"
            },
            {
              "name": "AppSettings__IssuerAuthority",
              "value": "[parameters('issuerAuthority')]"
            },
            {
              "name": "AppSettings__VerifierAuthority",
              "value": "[parameters('verifierAuthority')]"
            },
            {
              "name": "AppSettings__CredentialManifest",
              "value": "[parameters('credentialManifest')]"
            },
            {
              "name": "AppSettings__ManifestVerifiedIdentity",
              "value": "[parameters('manifestVerifiedIdentity')]"
            },
            {
              "name": "AppSettings__CPAuthorityId",
              "value": "[parameters('cpAuthorityId')]"
            },
            {
              "name": "AppSettings__VerificationProvider",
              "value": "[parameters('verificationProvider')]"
            },
            {
              "name": "AppSettings__ManifestEmployee",
              "value": "[parameters('manifestEmployee')]"
            },
            {
              "name": "AppSettings__ManifestIdTokenHint",
              "value": "[parameters('manifestIdTokenHint')]"
            },
            {
              "name": "AppSettings__ManifestIdToken",
              "value": "[parameters('manifestIdToken')]"
            },
            {
              "name": "AppSettings__ManifestPresentation",
              "value": "[parameters('manifestPresentation')]"
            },
            {
              "name": "AppSettings__ManifestSelfIssued",
              "value": "[parameters('manifestSelfIssued')]"
            },
            {
              "name": "AppSettings__ManifestMultiple",
              "value": "[parameters('manifestMultiple')]"
            },
            {
              "name": "AppSettings__TypeEmployee",
              "value": "[parameters('typeEmployee')]"
            },
            {
              "name": "AppSettings__TypeIdTokenHint",
              "value": "[parameters('typeIdTokenHint')]"
            },
            {
              "name": "AppSettings__TypeIdToken",
              "value": "[parameters('typeIdToken')]"
            },
            {
              "name": "AppSettings__TypePresentation",
              "value": "[parameters('typePresentation')]"
            },
            {
              "name": "AppSettings__TypeSelfIssued",
              "value": "[parameters('typeSelfIssued')]"
            },
            {
              "name": "AppSettings__TypeMultiple",
              "value": "[parameters('typeMultiple')]"
            },
            {
              "name": "AppSettings__IdTokenHintClaims__given_name",
              "value": "[parameters('idTokenHintGivenName')]"
            },
            {
              "name": "AppSettings__IdTokenHintClaims__family_name",
              "value": "[parameters('idTokenHintFamilyName')]"
            },
            {
              "name": "AppSettings__MultipleClaims__given_name",
              "value": "[parameters('multipleGivenName')]"
            },
            {
              "name": "AppSettings__MultipleClaims__family_name",
              "value": "[parameters('multipleFamilyName')]"
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "webAppUrl": {
      "type": "string",
      "value": "[concat('https://', reference(variables('webSiteName')).defaultHostName)]"
    }
  }
}
